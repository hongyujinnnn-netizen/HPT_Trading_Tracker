VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# NOTE: Never put private API keys (Finnhub, GoldAPI, service_role, ...) in VITE_* variables.
# Everything prefixed with VITE_ is bundled into the public JavaScript and visible to anyone.
# Store private keys as Supabase Edge Function secrets instead:
#   supabase secrets set GOLDAPI_KEY=... CRON_SECRET=...
